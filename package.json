{
  "name": "saafsaans",
  "version": "1.0.0",
  "private": true,
  "description": "SaafSaans — a GenAI air-quality companion that turns winter-smog data into grounded, personalized action for families and communities.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "prettier --check . && eslint . && tsc --noEmit && vitest run && next build"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "clsx": "^2.1.1",
    "next": "^15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
