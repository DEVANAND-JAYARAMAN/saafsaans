# ---- SaafSaans environment ----
# Google Gemini (Google AI Studio) powers the GenAI narration layer.
# Get a free key at https://aistudio.google.com/apikey
# The app runs fully WITHOUT this key using a transparent deterministic fallback,
# so the demo never breaks — but set it to unlock the GenAI experience.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Air-quality + geocoding come from Open-Meteo (Copernicus CAMS), which is free
# and requires NO API key. Nothing to configure here.
